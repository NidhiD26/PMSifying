# Supabase Configuration (Cloud Boundary for SecretChat & Healthcare RBAC)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Assistant — Optional Remote Gateway
# ---------------------------------------------------------------------------
# The AI Assistant works fully offline with no configuration at all. It
# classifies your question, searches the bundled education library, and answers
# from facts the cycle engine has already computed. Nothing below is required.
#
# Set PMSIFY_ASSISTANT_GATEWAY to exactly "enabled" to additionally let a remote
# model rephrase those answers. Any other value, or leaving it unset, keeps the
# gateway OFF. This is the default and the recommended setting.
#
# The flag is deliberately NOT a NEXT_PUBLIC_ variable: the browser must not be
# able to read it, and the provider key must never reach a client bundle. The
# only endpoint that sees these is the server-side /api/assistant route.
#
# When enabled, the provider receives ONLY the redacted context built by
# src/lib/assistant/context.ts — aggregate counts, averages, and dates already
# computed by the cycle engine. It never receives your PIN, your PIN salt, your
# free-text notes, or your raw log records. A refusal (crisis, diagnosis,
# medication, or out-of-scope) is never forwarded at all.
# ---------------------------------------------------------------------------

# OFF unless set to exactly "enabled".
PMSIFY_ASSISTANT_GATEWAY=disabled

# Only read when the gateway is enabled. Server-side only.
PMSIFY_GEMMA_API_KEY=
PMSIFY_GEMMA_ENDPOINT=
PMSIFY_GEMMA_MODEL=gemma-3-27b-it
